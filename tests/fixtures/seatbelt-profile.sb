(version 1)
(deny default)
(allow process-fork)
(allow signal (target same-sandbox))
(deny process-info*)
(allow process-info* (target same-sandbox))
(allow sysctl-read)
(deny sysctl-read (sysctl-name-regex #"^kern\.proc"))
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo"))
(allow network-outbound (remote ip "*:*"))
(allow network-inbound (local ip "*:*"))
(allow network-bind (local ip "*:*"))
(allow network-outbound (literal "/private/var/run/mDNSResponder"))
(allow file-read* file-write* (literal "/dev/null") (literal "/dev/zero") (literal "/dev/random"))
(allow file-read* file-write* (literal "/dev/urandom") (literal "/dev/tty") (literal "/dev/dtracehelper"))
(allow file-read* file-write* (literal "/dev/ptmx"))
(allow file-ioctl (literal "/dev/ptmx"))
(allow pseudo-tty)
(deny file-read* file-write* (regex #"^/dev/ttys[0-9]+"))
(allow file-read* file-write* file-ioctl (require-all (regex #"^/dev/ttys[0-9]+") (extension "com.apple.sandbox.pty")))
(allow file-read-data file-read-metadata (literal "/"))
(allow file-read-metadata (literal "/etc") (literal "/tmp") (literal "/var"))
(allow file-read* process-exec* (subpath (param "SYSTEM_0")))
(allow file-read* process-exec* (subpath (param "SYSTEM_1")))
(allow file-read* process-exec* (subpath (param "SYSTEM_2")))
(allow file-read* process-exec* (subpath (param "SYSTEM_3")))
(allow file-read* process-exec* (subpath (param "SYSTEM_4")))
(allow file-read* (literal (param "SUPERVISOR")))
(allow file-read-metadata (literal (param "PARENT_0")))
(allow file-read-metadata (literal (param "PARENT_1")))
(allow file-read-metadata (literal (param "PARENT_2")))
(allow file-read-metadata (literal (param "PARENT_3")))
(allow file-read-metadata (literal (param "PARENT_4")))
(allow file-read-metadata (literal (param "PARENT_5")))
(allow file-read-metadata (literal (param "PARENT_6")))
(allow file-read-metadata (literal (param "PARENT_7")))
(allow file-read-metadata (literal (param "PARENT_8")))
(allow file-read-metadata (literal (param "PARENT_9")))
(allow file-read-metadata (literal (param "PARENT_10")))
(allow file-read-metadata (literal (param "PARENT_11")))
(allow file-read-metadata (literal (param "PARENT_12")))
(allow file-read-metadata (literal (param "PARENT_13")))
(allow file-read-metadata (literal (param "PARENT_14")))
(allow file-read-metadata (literal (param "PARENT_15")))
(allow file-read-metadata (literal (param "PARENT_16")))
(allow file-read-metadata (literal (param "PARENT_17")))
(allow file-read-metadata (literal (param "PARENT_18")))
(allow file-read-metadata (literal (param "PARENT_19")))
(allow file-read-metadata (literal (param "PARENT_20")))
(allow file-read-metadata (literal (param "PARENT_21")))
(allow file-read-metadata (literal (param "PARENT_22")))
(allow file-read-metadata (literal (param "PARENT_23")))
(allow file-read-metadata (literal (param "PARENT_24")))
(allow file-read-metadata (literal (param "PARENT_25")))
(allow file-read* file-write* process-exec* (subpath (param "STATE_0")))
(allow network-outbound (subpath (param "STATE_0")))
(allow file-read* file-write* process-exec* (subpath (param "MOUNT_0")))
(allow network-outbound (subpath (param "MOUNT_0")))
(allow file-read* process-exec* (subpath (param "MOUNT_1")))
(deny file-write* (subpath (param "MOUNT_1")))
(allow network-outbound (subpath (param "MOUNT_1")))
(allow file-read* file-write* process-exec* (subpath (param "MOUNT_2")))
(allow network-outbound (subpath (param "MOUNT_2")))
(allow file-read* file-write* process-exec* (subpath (param "STATE_1")))
(allow network-outbound (subpath (param "STATE_1")))
(allow file-read* process-exec* (subpath (param "RUNTIME_0")))
(deny file-write* (subpath (param "RUNTIME_0")))
(allow file-read* file-write* process-exec* (subpath (param "TEMP")))
(allow network-outbound (subpath (param "TEMP")))
(allow file-read* file-write* process-exec* (subpath (param "HOME")))
(allow network-outbound (subpath (param "HOME")))
(deny file-read* file-write* process-exec* network-outbound (subpath (param "MASK_0")))
(deny file-read* file-write* process-exec* network-outbound (literal (param "MASK_1")))
(deny file-write-unlink (literal (param "STATE_0")))
(deny file-write-unlink (literal (param "MOUNT_0")))
(deny file-write-unlink (literal (param "MOUNT_1")))
(deny file-write-unlink (literal (param "MOUNT_2")))
(deny file-write-unlink (literal (param "STATE_1")))
(deny file-write-unlink (literal (param "RUNTIME_0")))
(deny file-write-unlink (literal (param "TEMP")))
(deny file-write-unlink (literal (param "HOME")))
(deny file-write-unlink (literal (param "LINK_0")))
(deny file-write-unlink (literal (param "GUARD_0")))
(deny file-write-unlink (literal (param "GUARD_1")))
(deny file-write-unlink (literal (param "GUARD_2")))
(deny file-write-unlink (literal (param "GUARD_3")))
(deny file-write-unlink (literal (param "GUARD_4")))
(deny file-write-unlink (literal (param "GUARD_5")))
